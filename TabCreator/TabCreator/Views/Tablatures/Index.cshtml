@model IEnumerable<TabCreator.Models.Tablature>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserTab)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.UserTab)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.TablatureId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.TablatureId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.TablatureId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
