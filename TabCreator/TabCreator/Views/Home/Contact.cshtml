@{
	ViewData["Title"] = "Contact";
}

<head>
	<link rel="stylesheet" href="~/css/login-register.css" />
</head>

<div id="contact-main" class="container">
	<h1>@ViewData["Title"]</h1>
	<p>
		Use this page to inform us of bugs you've found while using the site or tell us about features you'd like to see.
	</p>
	<div>
		<form id="contactform">
			<input type="email" id="email" name="email" placeholder="E-Mail" />
			<select id="topic" name="topic">
				<option value="bug">Bug Report</option>
				<option value="request">Feature Request</option>
			</select>
			<input type="text" id="subject" name="subject" placeholder="Subject" />
			<textarea class="big-text-box" id="content" name="content" placeholder="E-mail content"></textarea>
			<input type="submit" value="Submit" />
		</form>
	</div>
</div>
